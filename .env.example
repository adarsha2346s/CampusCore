# Local Docker Compose values only. Copy to .env, replace every placeholder, and
# keep .env out of version control.
#
# Generate the JWT signing secret with: openssl rand -base64 48
# JWT_SECRET must be at least 32 bytes; it is read from the environment only.

DB_USERNAME=campuscore
DB_PASSWORD=replace-with-a-local-development-password
DB_ROOT_PASSWORD=replace-with-a-local-root-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:5173

# VITE_API_BASE_URL is inlined into the frontend bundle when the image is built
# (it is a build argument in docker-compose.yml, not a runtime variable).
VITE_API_BASE_URL=http://localhost:8080/api/v1